            <!-- 中上 -->
            <child>
              <object class="ttk.Frame" id="center_top">
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">0</property>
                  <property name="sticky">nsew</property>
                </layout>
                <containerlayout manager="grid">
                  <property type="col" id="0" name="weight">1</property>
                  <property type="row" id="0" name="weight">1</property>
                </containerlayout>

                <child>
                  <object class="ttk.Labelframe" id="settings_frame">
                    <property name="text" translatable="yes">设置区</property>
                    <property name="padding">4 2</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="sticky">nsew</property>
                    </layout>
                    <containerlayout manager="grid">
                      <property type="col" id="0" name="weight">1</property>
                      <property type="row" id="0" name="weight">0</property>
                      <property type="row" id="1" name="weight">1</property>
                    </containerlayout>

                    <child>
                      <object class="ttk.Frame" id="pages_container">
                        <layout manager="grid">
                          <property name="column">0</property>
                          <property name="row">0</property>
                          <property name="sticky">nsew</property>
                        </layout>
                        <containerlayout manager="grid">
                          <property type="col" id="0" name="weight">1</property>
                          <property type="row" id="0" name="weight">1</property>
                        </containerlayout>

                        <!-- activation page -->
                        <child>
                          <object class="ttk.Frame" id="page_activation_cv">
                            <layout manager="grid">
                              <property name="column">0</property>
                              <property name="row">0</property>
                              <property name="sticky">nsew</property>
                            </layout>
                            <containerlayout manager="grid">
                              <property type="col" id="0" name="minsize">112</property>
                            </containerlayout>

                            <child>
                              <object class="ttk.Label" id="lbl_activation_high_e_v">
                                <property name="text" translatable="yes">High E (V)</property>
                                <layout manager="grid">
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                  <property name="sticky">w</property>
                                  <property name="padx">0 8</property>
                                  <property name="pady">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="ttk.Entry" id="entry_activation_high_e_v">
                                <property name="textvariable">string:activation_high_e_v</property>
                                <property name="width">11</property>
                                <layout manager="grid">
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                  <property name="sticky">w</property>
                                  <property name="padx">0 2</property>
                                  <property name="pady">2</property>
                                </layout>
                              </object>
                            </child>

                            <child>
