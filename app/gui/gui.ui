<?xml version='1.0' encoding='utf-8'?>
<interface version="1.3">
  <object class="tk.Toplevel" id="toplevel1">
    <property name="geometry">690x471</property>
    <property name="title" translatable="yes">CHI660E 自动化 - ver 1.0</property>
    <property name="background">#eef1f5</property>
    <containerlayout manager="grid">
      <property type="col" id="0" name="weight">1</property>
      <property type="row" id="0" name="weight">1</property>
    </containerlayout>

    <child>
      <object class="ttk.Frame" id="mainframe">
        <property name="padding">3</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">0</property>
          <property name="sticky">nsew</property>
        </layout>
        <containerlayout manager="grid">
          <property type="col" id="0" name="weight">1</property>
          <property type="col" id="1" name="minsize">200</property>
          <property type="row" id="0" name="weight">1</property>
        </containerlayout>

        <!-- 左中宿主 -->
        <child>
          <object class="ttk.Frame" id="lc_host">
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">0</property>
              <property name="sticky">nsew</property>
              <property name="padx">0 2</property>
            </layout>
            <containerlayout manager="grid">
              <property type="col" id="0" name="minsize">205</property>
              <property type="col" id="1" name="weight">1</property>
              <property type="col" id="1" name="minsize">250</property>
              <property type="row" id="0" name="weight">1</property>
              <property type="row" id="1" name="weight">0</property>
            </containerlayout>

            <!-- 左上 -->
            <child>
              <object class="ttk.Frame" id="left_top">
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">0</property>
                  <property name="sticky">nsew</property>
                  <property name="padx">0 2</property>
                </layout>
                <containerlayout manager="grid">
                  <property type="col" id="0" name="weight">1</property>
                  <property type="row" id="0" name="weight">1</property>
                </containerlayout>

                <child>
                  <object class="ttk.Labelframe" id="task_frame">
                    <property name="text" translatable="yes">任务区</property>
                    <property name="padding">4 2</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="sticky">nsew</property>
                    </layout>
                    <containerlayout manager="grid">
                      <property type="col" id="0" name="weight">1</property>
                      <property type="col" id="1" name="weight">0</property>
                      <property type="col" id="2" name="weight">0</property>
                      <property type="row" id="6" name="weight">1</property>
                    </containerlayout>

                    <child>
                      <object class="ttk.Frame" id="row_activation_cv">
                        <layout manager="grid">
                          <property name="column">0</property>
                          <property name="row">0</property>
                          <property name="columnspan">3</property>
                          <property name="sticky">ew</property>
                          <property name="pady">8</property>
                        </layout>
                        <containerlayout manager="grid">
                          <property type="col" id="1" name="weight">1</property>
                        </containerlayout>
                        <child>
                          <object class="ttk.Checkbutton" id="chk_activation_cv">
                            <property name="variable">boolean:enable_activation_cv</property>
                            <layout manager="grid">
                              <property name="column">0</property>
                              <property name="row">0</property>
                              <property name="padx">0 4</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="ttk.Label" id="lbl_activation_cv">
                            <property name="text" translatable="yes">活化</property>
                            <layout manager="grid">
                              <property name="column">1</property>
                              <property name="row">0</property>
                              <property name="sticky">w</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="ttk.Button" id="btn_activation_cv">
                            <property name="text" translatable="yes">设置</property>
                            <property name="width">5</property>
                            <property cbtype="simple" name="command" type="command">on_show_activation_cv</property>
                            <layout manager="grid">
                              <property name="column">2</property>
                              <property name="row">0</property>
                              <property name="sticky">e</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="ttk.Frame" id="row_eis_after_activation">
                        <layout manager="grid">
                          <property name="column">0</property>
                          <property name="row">1</property>
                          <property name="columnspan">3</property>
                          <property name="sticky">ew</property>
                          <property name="pady">8</property>
                        </layout>
                        <containerlayout manager="grid">
                          <property type="col" id="1" name="weight">1</property>
                        </containerlayout>
                        <child>
                          <object class="ttk.Checkbutton" id="chk_eis_after_activation">
                            <property name="variable">boolean:enable_eis_after_activation</property>
                            <layout manager="grid">
                              <property name="column">0</property>
                              <property name="row">0</property>
                              <property name="padx">0 4</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="ttk.Label" id="lbl_eis_after_activation">
                            <property name="text" translatable="yes">EIS-after activation</property>
                            <layout manager="grid">
                              <property name="column">1</property>
                              <property name="row">0</property>
                              <property name="sticky">w</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="ttk.Button" id="btn_eis_after_activation">
                            <property name="text" translatable="yes">设置</property>
                            <property name="width">5</property>
                            <property cbtype="simple" name="command" type="command">on_show_eis_after_activation</property>
                            <layout manager="grid">
                              <property name="column">2</property>
                              <property name="row">0</property>
                              <property name="sticky">e</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="ttk.Frame" id="row_cv_series">
                        <layout manager="grid">
                          <property name="column">0</property>
                          <property name="row">2</property>
                          <property name="columnspan">3</property>
                          <property name="sticky">ew</property>
                          <property name="pady">8</property>
                        </layout>
                        <containerlayout manager="grid">
                          <property type="col" id="1" name="weight">1</property>
