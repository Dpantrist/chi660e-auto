            <!-- 左下 -->
            <child>
              <object class="ttk.Frame" id="left_bottom_frame">
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">1</property>
                  <property name="sticky">nsew</property>
                  <property name="padx">0 2</property>
                  <property name="pady">2 0</property>
                </layout>
                <containerlayout manager="grid">
                  <property type="col" id="0" name="weight">1</property>
                  <property type="row" id="0" name="weight">0</property>
                  <property type="row" id="1" name="weight">0</property>
                </containerlayout>

                <child>
                  <object class="ttk.Labelframe" id="global_frame">
                    <property name="text" translatable="yes">全局设置</property>
                    <property name="padding">4 2</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="sticky">ew</property>
                      <property name="pady">0 2</property>
                    </layout>
                    <containerlayout manager="grid">
                      <property type="col" id="0" name="weight">1</property>
                    </containerlayout>
                    <child>
                      <object class="ttk.Button" id="btn_show_global_settings">
                        <property name="text" translatable="yes">打开设置页</property>
                        <property cbtype="simple" name="command" type="command">on_show_global_settings</property>
                        <layout manager="grid">
                          <property name="column">0</property>
                          <property name="row">0</property>
                          <property name="sticky">ew</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="tk.Button" id="start_button">
                    <property name="textvariable">string:start_button_text</property>
                    <property cbtype="simple" name="command" type="command">on_start_pause_clicked</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">1</property>
                      <property name="sticky">ew</property>
                      <property name="pady">1 0</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>

            <!-- 中下 -->
            <child>
              <object class="ttk.Frame" id="center_bottom_frame">
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">1</property>
                  <property name="sticky">nsew</property>
                  <property name="pady">2 0</property>
                </layout>
                <containerlayout manager="grid">
                  <property type="col" id="0" name="weight">1</property>
                  <property type="row" id="0" name="weight">1</property>
                </containerlayout>

                <child>
                  <object class="ttk.Labelframe" id="tips_frame">
                    <property name="text" translatable="yes">Tips</property>
                    <property name="padding">4 2</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="sticky">nsew</property>
                    </layout>
                    <containerlayout manager="grid">
                      <property type="col" id="0" name="weight">1</property>
                    </containerlayout>

                    <child>
                      <object class="ttk.Label" id="lbl_tips">
                        <property name="text" translatable="yes">测试前请依次打开工作站和CHI600E

运行中不要全屏或最小化CHI660E程序窗口</property>
                        <property name="justify">left</property>
                        <property name="wraplength">230</property>
                        <layout manager="grid">
                          <property name="column">0</property>
                          <property name="row">0</property>
                          <property name="sticky">w</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- 右列 -->
        <child>
          <object class="ttk.Frame" id="right_panel">
            <layout manager="grid">
              <property name="column">1</property>
              <property name="row">0</property>
              <property name="sticky">nsew</property>
            </layout>
            <containerlayout manager="grid">
              <property type="col" id="0" name="weight">1</property>
              <property type="row" id="1" name="weight">1</property>
            </containerlayout>

            <child>
              <object class="ttk.Labelframe" id="preview_frame">
                <property name="text" translatable="yes">执行计划预览</property>
                <property name="padding">4 2</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">0 2</property>
                </layout>
                <containerlayout manager="grid">
                  <property type="col" id="0" name="weight">1</property>
                  <property type="col" id="1" name="weight">0</property>
                  <property type="row" id="0" name="weight">1</property>
                </containerlayout>

                <child>
                  <object class="ttk.Treeview" id="preview_tree">
                    <property name="columns">index name status</property>
                    <property name="displaycolumns">index name status</property>
                    <property name="show">headings</property>
                    <property name="height">6</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="sticky">nsew</property>
                    </layout>
                  </object>
                </child>

                <child>
                  <object class="ttk.Scrollbar" id="preview_scrollbar">
                    <property name="orient">vertical</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="row">0</property>
                      <property name="sticky">ns</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="ttk.Labelframe" id="runtime_frame">
                <property name="text" translatable="yes">当前进程记录</property>
                <property name="padding">4 2</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">1</property>
                  <property name="sticky">nsew</property>
                </layout>
                <containerlayout manager="grid">
                  <property type="col" id="0" name="weight">1</property>
                  <property type="col" id="1" name="weight">0</property>
                  <property type="row" id="0" name="weight">1</property>
                </containerlayout>

                <child>
                  <object class="tk.Text" id="runtime_text">
                    <property name="width">22</property>
                    <property name="height">6</property>
                    <property name="wrap">word</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="sticky">nsew</property>
                    </layout>
                  </object>
                </child>

                <child>
                  <object class="ttk.Scrollbar" id="runtime_scrollbar">
                    <property name="orient">vertical</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="row">0</property>
                      <property name="sticky">ns</property>
                    </layout>
                  </object>
                </child>

                <child>
                  <object class="ttk.Frame" id="status_row">
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">1</property>
                      <property name="columnspan">2</property>
                      <property name="sticky">ew</property>
                      <property name="pady">1 0</property>
                    </layout>
                    <child>
                      <object class="ttk.Label" id="status_label">
                        <property name="textvariable">string:status_text</property>
                        <layout manager="grid">
                          <property name="column">0</property>
                          <property name="row">0</property>
                          <property name="sticky">w</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>
  </object>
</interface>